# CodeVinci Atlas — пример окружения (Master Spec §10.2)
# ВНИМАНИЕ: сюда ЗАПРЕЩЕНО класть tokens, cookies, API keys и любые
# provider credentials. Учётные данные живут только в изолированных root
# профилей и в auth store соответствующего CLI.

ATLAS_ENV=development
ATLAS_DATA_DIR=/var/lib/codevinci-atlas
ATLAS_RUNNER_SOCKET=/run/codevinci-atlas/runner.sock
ATLAS_WEB_ORIGIN=http://127.0.0.1:3210
ATLAS_LOG_LEVEL=INFO

# Для локального прогона VP-0 без прав на системные каталоги можно указать
# repo-local каталог данных (он в .gitignore):
# ATLAS_DATA_DIR=./var
